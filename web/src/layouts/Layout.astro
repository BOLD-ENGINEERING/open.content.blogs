---
import { blogConfig } from "../utils/blog-config";

interface Props {
  title?: string;
  description?: string;
}

const { title = blogConfig.title, description = blogConfig.description } =
  Astro.props;
const canonical = new URL(Astro.url.pathname, blogConfig.baseUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={blogConfig.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === blogConfig.title ? title : `${title} · ${blogConfig.title}`}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="site-title" href="/">
          {blogConfig.title}
        </a>
        <p>{blogConfig.description}</p>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        © {new Date().getFullYear()} {blogConfig.author}
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    font-family: Georgia, "Times New Roman", serif;
    color: #1b2421;
    background: #f8f7f2;
  }

  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
  a {
    color: #1d5b48;
  }
  a:hover {
    color: #123c30;
  }
  .shell {
    width: min(100% - 2.5rem, 760px);
    margin: 0 auto;
  }
  .site-header {
    padding: 3rem 0 1.5rem;
    border-bottom: 1px solid #d9ded7;
  }
  .site-title {
    color: inherit;
    font-size: 1.6rem;
    font-weight: 700;
    text-decoration: none;
  }
  .site-header p {
    color: #5c6762;
    margin: 0.4rem 0 0;
  }
  main {
    min-height: 55vh;
    padding: 2rem 0 4rem;
  }
  footer {
    border-top: 1px solid #d9ded7;
    color: #66716a;
    padding: 1.4rem 0 3rem;
    font-size: 0.9rem;
  }
  .post-meta {
    color: #66716a;
    font:
      0.9rem system-ui,
      sans-serif;
  }
  .post-body {
    font-size: 1.12rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .post-body img {
    max-width: 100%;
    height: auto;
  }
  .post-body pre {
    overflow-x: auto;
    padding: 1rem;
    background: #e9eee9;
    border-radius: 0.5rem;
  }
  .post-body code {
    font-size: 0.9em;
  }
  .post-body blockquote {
    margin-left: 0;
    padding-left: 1rem;
    border-left: 3px solid #9bb3a6;
    color: #4e5a53;
  }
  h1,
  h2,
  h3 {
    line-height: 1.2;
  }
</style>
